{
  "expo": {
    "name": "BunkMates",
    "slug": "bunkmates-v2",
    "version": "1.0.0",
    "description": "BunkMates - Ultimate travel and trip planning app for friends, trips, and bunking together.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bunkmates",
    "owner": "iam_sahilsuman",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bm.bunkmates",
      "infoPlist": {
        "LSApplicationCategoryType": "public.app-category.travel"
      },
      "associatedDomains": [
        "applinks:bunk-mates-beccc.firebaseapp.com",
        "applinks:bunk-mates-beccc.web.app",
        "applinks:bunk-mates.vercel.app",
        "applinks:app.bunkmates.xyz",
        "applinks:bunkmates.xyz"
      ]
    },
    "android": {
      "package": "com.bm.bunkmates",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bunk-mates-beccc.firebaseapp.com"
            },
            {
              "scheme": "https",
              "host": "bunk-mates-beccc.web.app"
            },
            {
              "scheme": "https",
              "host": "bunk-mates.vercel.app"
            },
            {
              "scheme": "https",
              "host": "app.bunkmates.xyz"
            },
            {
              "scheme": "https",
              "host": "bunkmates.xyz"
            },
            {
              "scheme": "http",
              "host": "bunk-mates-beccc.firebaseapp.com"
            },
            {
              "scheme": "http",
              "host": "bunk-mates-beccc.web.app"
            },
            {
              "scheme": "http",
              "host": "bunk-mates.vercel.app"
            },
            {
              "scheme": "http",
              "host": "app.bunkmates.xyz"
            },
            {
              "scheme": "http",
              "host": "bunkmates.xyz"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "geo"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ],
      "permissions": [
        "NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "USE_FULL_SCREEN_INTENT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00e6b0"
        }
      ],
      "expo-image",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BunkMates to access your camera for video calls.",
          "microphonePermission": "Allow BunkMates to access your microphone for voice calls.",
          "recordAudioAndroid": true
        }
      ],
      "./scripts/withIncomingCall.js",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.bm.bunkmates.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.bm.bunkmates.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "9ab7093d-32f1-4cb6-a7b3-67f82abf1b65"
      }
    }
  }
}
