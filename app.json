{
  "expo": {
    "name": "bunkmates-v2",
    "slug": "bunkmates-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bunkmates",
    "owner": "mohithac",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/expo.icon"
    },

    "android": {
      "package": "com.bm.bunkmates",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "BLUETOOTH"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sharing",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BunkMates to access your camera for video calls.",
          "microphonePermission": "Allow BunkMates to access your microphone for voice calls.",
          "recordAudioAndroid": true
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae9166e7-8f27-477b-b829-7f007e1c91da"
      }
    }
  }
}